{
  "name": "@bitfloo/mailoo",
  "version": "0.2.1",
  "mcpName": "io.github.Bitfloo/mailoo",
  "description": "Mailoo — email MCP server for IMAP, SMTP, and ManageSieve. Multi-account, per-folder profiles.",
  "type": "module",
  "bin": {
    "mailoo": "dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COPYING",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "biome format --write src/",
    "format:check": "biome check src/",
    "ci:local": "bash scripts/ci-local.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:all": "vitest run && vitest run --config vitest.config.integration.ts",
    "check": "biome check src/ && eslint src/",
    "report": "mkdir -p reports && biome check src/ --reporter=json > reports/biome.json 2>&1; eslint src/ -f json -o reports/eslint.json; actionlint -format '{{json .}}' > reports/actionlint.json 2>&1; pnpm test",
    "commit": "cog commit",
    "changelog": "cog changelog",
    "version:check": "cog check",
    "version:bump": "cog bump --auto",
    "version:bump:minor": "cog bump --minor",
    "version:bump:patch": "cog bump --patch",
    "version:log": "cog log",
    "prepare": "lefthook install || true",
    "hooks:install": "lefthook install --force",
    "hooks:uninstall": "lefthook uninstall",
    "docker:build": "docker build -t ghcr.io/bitfloo/mailoo .",
    "docker:run": "docker run --rm -i -v ~/.config/mailoo:/home/node/.config/mailoo:ro ghcr.io/bitfloo/mailoo",
    "docker:compose": "docker compose up",
    "docker:clean": "docker images --format '{{.Repository}}:{{.Tag}}' | grep mailoo | xargs docker rmi -f 2>/dev/null; true",
    "docker:prune": "docker image prune -f && docker buildx prune -f",
    "release:check": "goreleaser check",
    "release:snapshot": "goreleaser release --snapshot --clean && pnpm docker:clean",
    "release:dry-run": "goreleaser release --skip=publish --clean && pnpm docker:clean",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "email",
    "mcp",
    "imap",
    "smtp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "anthropic",
    "ai-tools",
    "llm",
    "nodejs"
  ],
  "author": {
    "name": "Bitfloo",
    "url": "https://github.com/Bitfloo"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitfloo/mailoo.git"
  },
  "homepage": "https://github.com/Bitfloo/mailoo#readme",
  "bugs": {
    "url": "https://github.com/Bitfloo/mailoo/issues"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "imapflow": "^1.7.8",
    "node-ical": "^0.25.2",
    "nodemailer": "^10.1.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "lefthook": "^2.2.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.7"
}
