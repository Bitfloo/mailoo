# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder

WORKDIR /app

# With the +sha512 suffix (the integrity in docker/pnpm-cli/npm-shrinkwrap.json)
# corepack checks the download against the repo, not registry metadata.
RUN corepack enable && corepack prepare pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd --activate

# Install dependencies (layer cached unless lock changes)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Build TypeScript
COPY tsconfig.json tsconfig.build.json ./
COPY src/ src/
RUN pnpm build

# Remove dev dependencies
RUN pnpm prune --prod

# ── Production stage ──────────────────────────────────────────────────────────
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS production

LABEL org.opencontainers.image.title="Mailoo" \
      org.opencontainers.image.description="Email, calendar, reminders & ManageSieve MCP server (IMAP/SMTP, AI triage, scheduling, OAuth2)." \
      org.opencontainers.image.url="https://github.com/bitfloo/mailoo" \
      org.opencontainers.image.source="https://github.com/bitfloo/mailoo" \
      org.opencontainers.image.licenses="LGPL-3.0-or-later" \
      org.opencontainers.image.vendor="Bitfloo"

WORKDIR /app

# Copy only production artifacts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY LICENSE COPYING NOTICE ./

# Create config directory for volume mount
RUN mkdir -p /home/node/.config/mailoo && chown -R node:node /home/node/.config

ENV NODE_ENV=production

# No HEALTHCHECK: the default command is stdio and does not listen on a port.
USER node

ENTRYPOINT ["node", "dist/main.js"]
CMD ["stdio"]
